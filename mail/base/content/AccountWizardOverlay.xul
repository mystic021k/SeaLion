<!DOCTYPE overlay SYSTEM "chrome://messenger/locale/AccountWizard.dtd">

<overlay xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">
  <script type="application/javascript"
          src="chrome://messenger/content/AccountWizardOverlay.js"/>
  <wizard id="AccountWizard">
    <wizardpage id="accounttype">
      <radiogroup id="acctyperadio">
        <radio id="mailaccount"
               insertbefore="ispBox"
               value="mailaccount"
               label="&accountTypeMail.label;"
               accesskey="&accountTypeMail.accesskey;"/>
      </radiogroup>
    </wizardpage>
  </wizard>
</overlay>
